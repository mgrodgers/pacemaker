# Required by api/feedback.ts (the in-app feedback button). Set these as
# Vercel Environment Variables (Production + Preview) — see
# docs/plans/feedback-github-issue.md for the full setup.

# Fine-grained GitHub PAT scoped to GITHUB_REPO with "Issues: Read and write".
GITHUB_TOKEN=

# owner/repo the feedback button files issues against.
GITHUB_REPO=mgrodgers/pacemaker

# Optional: tune the best-effort per-IP rate limit (defaults: 3 per 10 minutes).
FEEDBACK_RATE_LIMIT_MAX=
FEEDBACK_RATE_LIMIT_WINDOW_MS=
